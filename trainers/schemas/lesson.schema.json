{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app.kodislovo.ru/trainers/schemas/lesson.schema.json",
  "title": "Kodislovo lesson v1",
  "type": "object",
  "required": [
    "id",
    "version",
    "subject",
    "grade",
    "lesson",
    "title",
    "mode",
    "estimatedMinutes",
    "tasks",
    "stages",
    "material",
    "display",
    "manualGroups",
    "writingTaskIds",
    "finalTaskId",
    "checklist"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "enum": [
        "russian",
        "literature"
      ]
    },
    "grade": {
      "type": "integer",
      "minimum": 5,
      "maximum": 11
    },
    "lesson": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "practice",
        "independent",
        "control"
      ]
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 1
    },
    "pacing": {
      "type": "string"
    },
    "display": {
      "type": "object",
      "required": [
        "heroTitle",
        "heroAccent",
        "description",
        "pills",
        "journey",
        "scoreNote",
        "automaticDescription",
        "completionTitle"
      ],
      "properties": {
        "heroTitle": {
          "type": "string"
        },
        "heroAccent": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "pills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "journey": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "description"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "scoreNote": {
          "type": "string"
        },
        "automaticDescription": {
          "type": "string"
        },
        "completionTitle": {
          "type": "string"
        },
        "workspaceLabel": {
          "type": "string"
        },
        "automaticNote": {
          "type": "string"
        },
        "manualLabel": {
          "type": "string"
        },
        "workHeading": {
          "type": "string"
        },
        "scaleNote": {
          "type": "string"
        },
        "draftNotice": {
          "type": "string"
        },
        "showStartNotes": {
          "type": "boolean"
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "material": {
      "type": "object",
      "required": [
        "paragraphs",
        "samples",
        "attribution"
      ],
      "properties": {
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attribution": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "writingTaskIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "finalTaskId": {
      "type": "string"
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manualGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "task_ids",
          "criteria"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "task_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "text",
                "points"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "points": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "revisionMode": {
      "enum": [
        "draft-and-final",
        "final-only"
      ]
    }
  },
  "$defs": {
    "option": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "type",
        "stage",
        "skill",
        "prompt",
        "points"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string"
        },
        "skill": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string"
        },
        "points": {
          "type": "number",
          "minimum": 0
        },
        "type": {
          "enum": [
            "single-choice",
            "multi-choice",
            "match",
            "order",
            "classify",
            "select-text",
            "fill",
            "open-response"
          ]
        },
        "optional": {
          "type": "boolean"
        },
        "paragraph": {
          "type": "integer",
          "minimum": 1
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "errorTags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rubric": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hint": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "showFullText": {
          "type": "boolean"
        },
        "referenceTitle": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "single-choice"
              }
            }
          },
          "then": {
            "required": [
              "options",
              "answer"
            ],
            "properties": {
              "answer": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "multi-choice",
                  "select-text"
                ]
              }
            }
          },
          "then": {
            "required": [
              "options",
              "answer"
            ],
            "properties": {
              "answer": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "order"
              }
            }
          },
          "then": {
            "required": [
              "items",
              "answer"
            ],
            "properties": {
              "answer": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "match",
                  "classify"
                ]
              }
            }
          },
          "then": {
            "required": [
              "items",
              "groups",
              "answer"
            ],
            "properties": {
              "answer": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "fill"
              }
            }
          },
          "then": {
            "required": [
              "items",
              "answers"
            ],
            "properties": {
              "answers": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "open-response"
              }
            }
          },
          "then": {
            "properties": {
              "points": {
                "const": 0
              }
            }
          }
        }
      ]
    }
  }
}
